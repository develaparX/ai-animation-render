{
  "total_dur": 25.3,
  "segments": [
    {
      "id": "hook",
      "text": "Otakmu merekam semua yang kamu katakan ke diri sendiri.",
      "dur": 2.394458,
      "start": 0.06,
      "end": 2.454
    },
    {
      "id": "record",
      "text": "Setiap kalimat pedas yang kamu ulang-ulang perlahan jadi pola jalur saraf yang makin kuat.",
      "dur": 3.759417,
      "start": 2.654,
      "end": 6.414
    },
    {
      "id": "alarm",
      "text": "Sistem waspada di otak ikut menyala, seolah ancaman itu nyata dan selalu dekat.",
      "dur": 3.965958,
      "start": 6.664,
      "end": 10.63
    },
    {
      "id": "body",
      "text": "Bahu menegang, napas memendek, fokus menyempit — tubuhmu ikut percaya pada kata-katamu.",
      "dur": 5.203958,
      "start": 10.88,
      "end": 16.084
    },
    {
      "id": "flip",
      "text": "Sebaliknya, kalimat yang tenang dan jelas memberi otak peta baru yang lebih aman.",
      "dur": 3.84375,
      "start": 16.334,
      "end": 20.178
    },
    {
      "id": "habit",
      "text": "Bukan soal pura-pura bahagia, tapi melatih bahasa batin yang jujur dan menenangkan.",
      "dur": 4.422333,
      "start": 20.428,
      "end": 24.85
    }
  ],
