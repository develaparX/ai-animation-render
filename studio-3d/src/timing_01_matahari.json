{
  "id": "01_matahari",
  "total_dur": 27.845,
  "segments": [
    {
      "id": "hook",
      "text": "Sekarang ini juga, cahaya matahari butuh delapan menit buat sampai ke matamu.",
      "dur": 3.706792,
      "start": 0.06,
      "end": 3.767
    },
    {
      "id": "calm",
      "text": "Artinya kalau detik ini matahari meledak, kamu masih ngopi santai tanpa tahu apa-apa.",
      "dur": 4.108417,
      "start": 3.927,
      "end": 8.035
    },
    {
      "id": "flash",
      "text": "Begitu menit kedelapan lewat dua puluh detik, seluruh langit mendadak putih menyilaukan!",
      "dur": 3.965125,
      "start": 8.255,
      "end": 12.22
    },
    {
      "id": "boil",
      "text": "Dalam hitungan menit, suhu melonjak ribuan derajat dan lautan mulai mendidih jadi uap raksasa.",
      "dur": 4.756417,
      "start": 12.5,
      "end": 17.257
    },
    {
      "id": "ember",
      "text": "Bumi berputar tanpa pegangan, menyisakan bara panas meluncur sendirian di ruang gelap.",
      "dur": 4.074167,
      "start": 17.507,
      "end": 21.581
    },
    {
      "id": "cta",
      "text": "Menurutmu, apa yang sempat kamu lakuin di delapan menit terakhir itu? Tulis di komentar.",
      "dur": 5.064125,
      "start": 21.931,
      "end": 26.995
    }
  ],
