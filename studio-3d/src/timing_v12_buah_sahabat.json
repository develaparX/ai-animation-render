{
  "total_dur": 24.524,
  "segments": [
    {
      "id": "hook",
      "text": "Dua buah yang beda banget ini ternyata sahabatan.",
      "dur": 2.210542,
      "start": 0.06,
      "end": 2.271
    },
    {
      "id": "meet",
      "text": "Yang satu manis dan ceria, satunya lagi asam dan pendiam — tapi mereka selalu bareng.",
      "dur": 4.693917,
      "start": 2.471,
      "end": 7.164
    },
    {
      "id": "share",
      "text": "Kalau yang satu dapat sinar matahari lebih, ia bergeser supaya temannya ikut kebagian.",
      "dur": 4.330125,
      "start": 7.414,
      "end": 11.745
    },
    {
      "id": "storm",
      "text": "Saat badai datang, mereka saling menahan supaya nggak ada yang jatuh duluan.",
      "dur": 3.658708,
      "start": 11.995,
      "end": 15.653
    },
    {
      "id": "grow",
      "text": "Musim berganti, keduanya matang bareng, manisnya pun jadi seimbang.",
      "dur": 3.899333,
      "start": 15.933,
      "end": 19.833
    },
    {
      "id": "warm",
      "text": "Kadang teman terbaik itu yang paling beda dari kita, tapi selalu ada di samping kita.",
      "dur": 3.991875,
      "start": 20.083,
      "end": 24.075
    }
