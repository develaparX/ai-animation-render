{
  "total_dur": 27.226,
  "segments": [
    {
      "id": "hook",
      "text": "Baru sekali hisap, paru-parumu langsung berubah begini.",
      "dur": 2.713458,
      "start": 0.06,
      "end": 2.773
    },
    {
      "id": "smoke",
      "text": "Asap panas masuk lewat tenggorokan, lalu menyebar ke jutaan kantung udara kecil di paru-paru.",
      "dur": 4.524833,
      "start": 2.973,
      "end": 7.498
    },
    {
      "id": "tar",
      "text": "Lapisan lengket menempel di dinding saluran napas, perlahan menyempitkan jalan keluar masuknya udara.",
      "dur": 4.768125,
      "start": 7.748,
      "end": 12.516
    },
    {
      "id": "cilia",
      "text": "Rambut-rambut halus pembersih yang biasanya menyapu kotoran mulai lumpuh dan berhenti bergerak.",
      "dur": 4.081583,
      "start": 12.766,
      "end": 16.848
    },
    {
      "id": "oxygen",
      "text": "Pertukaran oksigen melambat, jantung dipaksa memompa lebih keras untuk hal yang dulu mudah.",
      "dur": 4.345833,
      "start": 17.098,
      "end": 21.444
    },
    {
      "id": "heal",
      "text": "Kabar baiknya, begitu kamu berhenti, tubuh langsung mulai membersihkan dirinya sedikit demi sedikit.",
      "dur": 5.082375,
      "start": 21.694,
      "end": 26.776
    }
  ],
