{
  "total_dur": 27.199,
  "segments": [
    {
      "id": "hook",
      "text": "Orang pendiam itu bukan cuek, otaknya justru bekerja lebih dalam.",
      "dur": 3.227167,
      "start": 0.06,
      "end": 3.287
    },
    {
      "id": "observe",
      "text": "Di keramaian, mereka sibuk membaca ekspresi, nada suara, dan bahasa tubuh orang lain.",
      "dur": 5.412417,
      "start": 3.487,
      "end": 8.9
    },
    {
      "id": "process",
      "text": "Informasi itu diputar ulang di kepala, disaring satu per satu sebelum jadi kata-kata.",
      "dur": 4.340583,
      "start": 9.15,
      "end": 13.49
    },
    {
      "id": "selective",
      "text": "Makanya mereka jarang bicara, tapi sekali bicara biasanya tepat dan jujur.",
      "dur": 3.999,
      "start": 13.74,
      "end": 17.739
    },
    {
      "id": "energy",
      "text": "Keramaian menguras baterai mereka, sementara waktu sendirian justru mengisi ulang.",
      "dur": 4.089292,
      "start": 17.989,
      "end": 22.078
    },
    {
      "id": "respect",
      "text": "Jadi kalau punya teman pendiam, hargai jedanya — di sanalah cara mereka peduli.",
      "dur": 4.420875,
      "start": 22.328,
      "end": 26.749
    }
  ],
