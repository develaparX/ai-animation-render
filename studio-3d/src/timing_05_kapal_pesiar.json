{
  "id": "05_kapal_pesiar",
  "total_dur": 28.069,
  "segments": [
    {
      "id": "hook",
      "text": "Terjatuh dari kapal pesiar tengah malam itu hampir mustahil ditemukan lagi.",
      "dur": 3.352292,
      "start": 0.06,
      "end": 3.412
    },
    {
      "id": "drop",
      "text": "Dari dek setinggi sepuluh lantai, benturan air laut rasanya sekeras menghantam aspal.",
      "dur": 4.38325,
      "start": 3.592,
      "end": 7.976
    },
    {
      "id": "shrink",
      "text": "Di antara ombak gelap, kapal raksasa itu tetap melaju dan menghilang cuma dalam satu menit.",
      "dur": 4.218917,
      "start": 8.216,
      "end": 12.434
    },
    {
      "id": "underwater",
      "text": "Di bawah permukaan, air dingin dua belas derajat pelan-pelan menguras tenaga dan suhu tubuhmu.",
      "dur": 4.722375,
      "start": 12.684,
      "end": 17.407
    },
    {
      "id": "scale",
      "text": "Dari udara, satu orang di samudra luas itu bahkan lebih kecil dari satu titik di peta.",
      "dur": 4.3225,
      "start": 17.667,
      "end": 21.989
    },
    {
      "id": "cta",
      "text": "Menurutmu peluang paling realistis untuk bertahan di situasi ini apa? Tulis pendapatmu.",
      "dur": 4.88,
      "start": 22.339,
      "end": 27.219
    }
  ],
