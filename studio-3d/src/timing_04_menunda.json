  "segments": [
    {
      "id": "hook",
      "text": "Sering nunda kerjaan bukan berarti malas, kadang otakmu lagi kerja diam-diam.",
      "dur": 3.807292,
      "start": 0.06,
      "end": 3.867
    },
    {
      "id": "overload",
      "text": "Pas kamu paksa mikir di depan dua layar penuh kode, bagian otak depan justru gampang penuh.",
      "dur": 4.294875,
      "start": 4.047,
      "end": 8.342
    },
    {
      "id": "incubate",
      "text": "Begitu kamu tinggal jalan sebentar atau bikin kopi, jaringan dalam otak baru mulai menyambung.",
      "dur": 4.475958,
      "start": 8.562,
      "end": 13.038
    },
    {
      "id": "spark",
      "text": "Di fase tenang itulah potongan ide yang tadinya buntu tiba-tiba ketemu polanya!",
      "dur": 3.502125,
      "start": 13.278,
      "end": 16.78
    },
    {
      "id": "solve",
      "text": "Jadi jeda sebentar sebelum balik lagi sering bikin masalah kelar lebih cepat.",
